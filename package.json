{
  "name": "web3bio-profile-kit",
  "version": "0.2.20",
  "description": "React hooks for querying ENS, Lens, Farcaster and Web3 universal profiles",
  "author": "web3bio",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "hooks": [
        "./dist/hooks/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "web3",
    "profile",
    "react",
    "hooks",
    "web3bio",
    "ens",
    "farcaster",
    "lens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/web3bio/web3bio-profile-kit"
  },
  "homepage": "https://github.com/web3bio/web3bio-profile-kit#readme",
  "bugs": {
    "url": "https://github.com/web3bio/web3bio-profile-kit/issues"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^4.0.0 || ^5.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@tanstack/react-query": "^5.104.5",
    "dotenv": "^16.6.1",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.10",
    "rollup": "^3.30.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.28>postcss": "8.5.28",
      "next@15.5.28>sharp": "0.35.5",
      "source-map-js": "1.2.2"
    }
  }
}
